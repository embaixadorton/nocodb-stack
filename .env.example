# PostgreSQL for NocoDB
POSTGRES_CONTAINER_NAME=nocodb-postgres
POSTGRES_DB=nocodb
POSTGRES_USER=nocodb_user
POSTGRES_PASSWORD=nocodb_db_password_here

# NocoDB Application
NOCODB_VERSION=0.202.6
NOCODB_CONTAINER_NAME=nocodb
NOCODB_PUBLIC_URL=https://nocodb.your-domain.com
NOCODB_JWT_SECRET=your_jwt_secret_here  # generate with `openssl rand -base64 32`
NOCODB_DISABLE_TELEMETRY=true
NOCODB_PORT=8080

# Traefik
TRAEFIK_HOST=nocodb.your-domain.com
